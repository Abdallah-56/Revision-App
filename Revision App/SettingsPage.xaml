<Page x:Class="Revision_App.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      FontFamily="Arial"
      Background="#F7F5FC">
    <Page.Resources>
        <SolidColorBrush x:Key="Purple" Color="#7044A3"/>
        <SolidColorBrush x:Key="DarkPurple" Color="#4E287C"/>
        <SolidColorBrush x:Key="MutedText" Color="#756B85"/>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2D8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Purple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,24,26,30">
            <TextBlock Text="Settings" FontSize="25" FontWeight="Bold"
                       Foreground="{StaticResource DarkPurple}"/>
            <TextBlock Text="Manage your account and revision preferences."
                       FontSize="13" Foreground="{StaticResource MutedText}"
                       Margin="0,7,0,22"/>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Account" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource DarkPurple}" Margin="0,0,0,16"/>
                    <TextBlock Text="Full name" Foreground="{StaticResource MutedText}" FontSize="12"/>
                    <TextBlock x:Name="AccountNameText" Text="Loading..."
                               FontSize="15" Margin="0,4,0,14"/>
                    <TextBlock Text="Email" Foreground="{StaticResource MutedText}" FontSize="12"/>
                    <TextBlock x:Name="AccountEmailText" Text="Loading..."
                               FontSize="15" Margin="0,4,0,14"/>
                    <TextBlock Text="XP earned" Foreground="{StaticResource MutedText}" FontSize="12"/>
                    <TextBlock x:Name="AccountXPText" Text="—" FontFamily="Consolas"
                               FontSize="19" Foreground="{StaticResource Purple}" Margin="0,4,0,14"/>
                    <TextBlock x:Name="AccountStatusText" Text=""
                               FontSize="12" Foreground="{StaticResource MutedText}"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <Button Content="Refresh account" Click="RefreshAccount_Click"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Revision Preferences" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource DarkPurple}" Margin="0,0,0,14"/>
                    <CheckBox x:Name="RemindersCheckBox"
                              Content="Show revision reminders"
                              Foreground="#29223A" FontSize="14"
                              Margin="0,0,0,18"/>
                    <TextBlock Text="Daily quiz goal" FontSize="13"
                               FontWeight="SemiBold" Foreground="#29223A"/>
                    <ComboBox x:Name="GoalComboBox" Width="160"
                              HorizontalAlignment="Left" Height="35"
                              Margin="0,8,0,8" SelectedIndex="1">
                        <ComboBoxItem Content="1 quiz" Tag="1"/>
                        <ComboBoxItem Content="2 quizzes" Tag="2"/>
                        <ComboBoxItem Content="3 quizzes" Tag="3"/>
                        <ComboBoxItem Content="5 quizzes" Tag="5"/>
                    </ComboBox>
                    <TextBlock Text="The goal is based on completed quizzes, not estimated study time."
                               Foreground="{StaticResource MutedText}" FontSize="12"
                               Margin="0,0,0,15" TextWrapping="Wrap"/>
                    <Button Content="Save Preferences" Click="SavePreferences_Click"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="PreferencesStatusText" Text=""
                               FontSize="12" Foreground="{StaticResource Purple}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Data" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource DarkPurple}" Margin="0,0,0,10"/>
                    <TextBlock Text="Quiz results, XP and progress are saved to Supabase. Preferences are saved on this Windows computer for your account."
                               TextWrapping="Wrap" Foreground="#29223A" FontSize="13"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Session" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource DarkPurple}" Margin="0,0,0,10"/>
                    <TextBlock Text="Log out of CompRev on this computer."
                               FontSize="13" Foreground="{StaticResource MutedText}"
                               Margin="0,0,0,12"/>
                    <Button Content="Log Out" Click="LogOutFromSettings_Click"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
