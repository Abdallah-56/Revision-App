<Window x:Name="RevisionApp" x:Class="Revision_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Revision_App"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1000" MinWidth="800" MinHeight="600" FontSize="14">
    <Grid x:Name="Revision_App" Width="1000" Height="700" MinWidth="800" MinHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label x:Name="WelcomeLabel" Content="Welcome" HorizontalAlignment="Center" Margin="0,82,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.534,0.524" Height="50" Width="172" FontSize="36" FontFamily="Arial" FontWeight="Bold" Background="#FFC242F3" FontStyle="Italic">
            <Label.Effect>
                <DropShadowEffect/>
            </Label.Effect>
        </Label>
        <PasswordBox x:Name="PasswordTextbox" HorizontalAlignment="Center" Height="28" Margin="0,322,0,0" VerticalAlignment="Top" Width="268" BorderBrush="#FFC242F3"/>
        <TextBox x:Name="UsernameTextBox" TextWrapping="Wrap" Margin="366,237,366,436" BorderBrush="#FFC242F3"/>
        <Button Content="Sign In" HorizontalAlignment="Center" Height="64" Margin="0,409,0,0" VerticalAlignment="Top" Width="268" Click="Button_Click" BorderBrush="#FFC242F3" Foreground="#FFC242F3" BorderThickness="4,4,4,4" Background="White" FontSize="48" FontFamily="Arial" FontStyle="Italic" FontWeight="Bold"/>
        <Button Content="Create Account" HorizontalAlignment="Center" Height="47" Margin="0,515,0,0" VerticalAlignment="Top" Width="268" Click="Button_Click" BorderBrush="#FFC242F3" Foreground="#FFC242F3" BorderThickness="4,4,4,4" Background="White" FontSize="24" FontFamily="Arial" FontStyle="Italic" FontWeight="Bold"/>
        <Label x:Name="Label0" Content="Email " HorizontalAlignment="Left" Margin="366,201,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.534,0.524" Height="31" Width="67" FontSize="20" FontFamily="Arial" FontWeight="Bold" Background="#FFC242F3" FontStyle="Italic">
            <Label.Effect>
                <DropShadowEffect/>
            </Label.Effect>
        </Label>
        <Label x:Name="Label0_Copy" Content="Password " HorizontalAlignment="Left" Margin="366,286,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.534,0.524" Height="31" Width="114" FontSize="20" FontFamily="Arial" FontWeight="Bold" Background="#FFC242F3" FontStyle="Italic">
            <Label.Effect>
                <DropShadowEffect/>
            </Label.Effect>
        </Label>
    </Grid>
</Window>
