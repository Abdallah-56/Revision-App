<Page x:Class="Revision_App.QuizPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Revision Quiz"
      Background="#F7F5FC"
      FontFamily="Arial">

    <Page.Resources>
        <SolidColorBrush x:Key="Purple" Color="#7044A3"/>
        <SolidColorBrush x:Key="DarkPurple" Color="#4E287C"/>
        <SolidColorBrush x:Key="MutedText" Color="#756B85"/>

        <Style x:Key="PurpleButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Purple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="AnswerOption" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,13"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,28">

            <Button Content="Back to Topics"
                    Click="BackToTopics_Click"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Foreground="{StaticResource Purple}"
                    BorderThickness="0"
                    FontSize="14"
                    Padding="0,5"
                    Cursor="Hand"
                    Margin="0,0,0,16"/>

            <TextBlock x:Name="TopicTitleText"
                       Text="Revision Quiz"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource DarkPurple}"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="StatusText"
                       Text="Loading questions from Supabase..."
                       Foreground="{StaticResource MutedText}"
                       FontSize="14"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"/>

            <!-- Quiz question and answer choices -->
            <StackPanel x:Name="QuizPanel"
                        Visibility="Collapsed"
                        Margin="0,20,0,0">

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="QuestionIndexText"
                               FontFamily="Consolas"
                               FontSize="14"
                               Foreground="{StaticResource MutedText}"/>

                    <TextBlock x:Name="ScoreText"
                               Grid.Column="1"
                               FontFamily="Consolas"
                               FontSize="14"
                               Foreground="{StaticResource Purple}"/>
                </Grid>

                <Border Background="White"
                        BorderBrush="#E2D8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22">
                    <StackPanel>
                        <TextBlock x:Name="DifficultyText"
                                   Foreground="{StaticResource MutedText}"
                                   FontSize="12"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="QuestionTextBlock"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#29223A"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,23"/>

                        <RadioButton x:Name="AnswerA" Tag="A" GroupName="QuizAnswers"
                                     Style="{StaticResource AnswerOption}">
                            <TextBlock x:Name="OptionAText" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="AnswerB" Tag="B" GroupName="QuizAnswers"
                                     Style="{StaticResource AnswerOption}">
                            <TextBlock x:Name="OptionBText" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="AnswerC" Tag="C" GroupName="QuizAnswers"
                                     Style="{StaticResource AnswerOption}">
                            <TextBlock x:Name="OptionCText" TextWrapping="Wrap"/>
                        </RadioButton>
                        <RadioButton x:Name="AnswerD" Tag="D" GroupName="QuizAnswers"
                                     Style="{StaticResource AnswerOption}">
                            <TextBlock x:Name="OptionDText" TextWrapping="Wrap"/>
                        </RadioButton>

                        <StackPanel x:Name="FeedbackPanel"
                                    Visibility="Collapsed"
                                    Margin="0,8,0,14">
                            <TextBlock x:Name="FeedbackText"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="ExplanationText"
                                       FontSize="14"
                                       Foreground="{StaticResource MutedText}"
                                       Margin="0,7,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SubmitButton"
                                    Content="Submit Answer"
                                    Style="{StaticResource PurpleButton}"
                                    Click="SubmitAnswer_Click"/>

                            <Button x:Name="NextButton"
                                    Content="Next Question"
                                    Style="{StaticResource PurpleButton}"
                                    Click="NextQuestion_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Final quiz results -->
            <Border x:Name="ResultsPanel"
                    Visibility="Collapsed"
                    Background="White"
                    BorderBrush="#E2D8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Quiz Complete"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource DarkPurple}"/>
                    <TextBlock x:Name="ResultScoreText"
                               FontFamily="Consolas"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource Purple}"
                               Margin="0,15,0,7"/>
                    <TextBlock x:Name="ResultDetailText"
                               FontSize="14"
                               Foreground="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>
                    <Button Content="Try Again"
                            Style="{StaticResource PurpleButton}"
                            HorizontalAlignment="Left"
                            Click="RestartQuiz_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

