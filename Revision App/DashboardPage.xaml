<Page x:Class="Revision_App.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard"
      Background="#F7F5FC"
      FontFamily="Arial">

    <Page.Resources>
        <SolidColorBrush x:Key="Purple" Color="#7044A3"/>
        <SolidColorBrush x:Key="DarkPurple" Color="#4E287C"/>
        <SolidColorBrush x:Key="LightPurple" Color="#EEE6F8"/>
        <SolidColorBrush x:Key="TextColour" Color="#29223A"/>
        <SolidColorBrush x:Key="MutedText" Color="#756B85"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColour}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2D8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2D8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2D8F0"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <TextBlock Grid.Column="0"
                           Text="CompRev"
                           FontFamily="Consolas"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource Purple}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <TextBlock Grid.Column="1"
                           Text="Dashboard"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="{StaticResource DarkPurple}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Notification and profile PNG placeholders -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Border Width="36" Height="36"
                            Margin="0,0,8,0"
                            Background="{StaticResource LightPurple}"
                            CornerRadius="8">
                        <Image Source="Images/notification.png"
                               Width="23" Height="23"
                               Stretch="Uniform"
                               ToolTip="Notifications"/>
                    </Border>

                    <Border Width="36" Height="36"
                            Background="{StaticResource LightPurple}"
                            CornerRadius="18">
                        <Image Source="Images/profile.png"
                               Width="25" Height="25"
                               Stretch="Uniform"
                               ToolTip="Profile"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E2D8F0"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,18,0,0">

                        <Button Style="{StaticResource NavButton}"
                                Background="{StaticResource LightPurple}"
                                Foreground="{StaticResource DarkPurple}"
                                FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/home.png"
                                       Width="22" Height="22"
                                       Margin="0,0,10,0"
                                       Stretch="Uniform"/>
                                <TextBlock Text="Home"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/revision.png"
                                       Width="22" Height="22"
                                       Margin="0,0,10,0"
                                       Stretch="Uniform"/>
                                <TextBlock Text="Revision"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/progress.png"
                                       Width="22" Height="22"
                                       Margin="0,0,10,0"
                                       Stretch="Uniform"/>
                                <TextBlock Text="Progress"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/settings.png"
                                       Width="22" Height="22"
                                       Margin="0,0,10,0"
                                       Stretch="Uniform"/>
                                <TextBlock Text="Settings"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Log out -->
                    <Border Grid.Row="2"
                            BorderBrush="#E2D8F0"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,15">
                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/logout.png"
                                       Width="22" Height="22"
                                       Margin="0,0,10,0"
                                       Stretch="Uniform"/>
                                <TextBlock Text="Log Out"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- Main dashboard -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,22,24,24">

                    <!-- Welcome message -->
                    <TextBlock x:Name="WelcomeText"
                               Text="Welcome"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColour}"/>

                    <TextBlock x:Name="StatusText"
                               Text="Your revision overview"
                               FontSize="13"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,5,0,18"/>

                    <!-- Statistics -->
                    <UniformGrid Columns="3" Margin="-5,0,-5,12">

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Topics Studied"
                                           FontSize="14"
                                           Foreground="{StaticResource MutedText}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="TopicsText"
                                           Text="—"
                                           FontFamily="Consolas"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Purple}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="XP Earned"
                                           FontSize="14"
                                           Foreground="{StaticResource MutedText}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock x:Name="XPText"
                                           Text="—"
                                           FontFamily="Consolas"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Purple}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Average Score"
                                           FontSize="14"
                                           Foreground="{StaticResource MutedText}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="AverageScoreText"
                                           Text="—"
                                           FontFamily="Consolas"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Purple}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Recent activity and topics to revise -->
                    <Grid Margin="-5,0,-5,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource SectionCard}"
                                MinHeight="175">
                            <StackPanel>
                                <TextBlock Text="Recent Activity"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DarkPurple}"
                                           Margin="0,0,0,14"/>

                                <TextBlock Text="Your recent revision sessions"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedText}"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="No activity recorded yet."
                                           FontSize="13"
                                           Foreground="{StaticResource TextColour}"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource SectionCard}"
                                MinHeight="175">
                            <StackPanel>
                                <TextBlock Text="Topics to Revise"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DarkPurple}"
                                           Margin="0,0,0,14"/>

                                <TextBlock Text="Your recommended revision topics"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedText}"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Recommendations will appear here."
                                           FontSize="13"
                                           Foreground="{StaticResource TextColour}"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Daily goal -->
                    <Border Style="{StaticResource SectionCard}"
                            Margin="5,0,5,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Daily Goal"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DarkPurple}"/>

                                <TextBlock Grid.Column="1"
                                           Text="0 / 30 minutes"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedText}"/>
                            </Grid>

                            <Border Background="{StaticResource LightPurple}"
                                    Height="10"
                                    CornerRadius="5"
                                    Margin="0,14,0,0">
                                <Border Background="{StaticResource Purple}"
                                        HorizontalAlignment="Left"
                                        Width="0"
                                        CornerRadius="5"/>
                            </Border>

                            <TextBlock Text="Complete a revision session to work towards your daily goal."
                                       FontSize="12"
                                       Foreground="{StaticResource MutedText}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Account details -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Account Details"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DarkPurple}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Name"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedText}"/>

                            <TextBlock x:Name="FullNameText"
                                       Text="Loading..."
                                       FontSize="14"
                                       Margin="0,4,0,12"
                                       Foreground="{StaticResource TextColour}"/>

                            <TextBlock Text="Email"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedText}"/>

                            <TextBlock x:Name="EmailText"
                                       Text="Loading..."
                                       FontSize="14"
                                       Margin="0,4,0,12"
                                       Foreground="{StaticResource TextColour}"/>

                            <Button Content="Refresh Dashboard"
                                    Click="RefreshButton_Click"
                                    HorizontalAlignment="Left"
                                    Padding="16,9"
                                    Background="{StaticResource Purple}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

