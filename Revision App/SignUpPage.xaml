<Page x:Class="Revision_App.SignUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SignUpPage">

    <Grid Background="White">
        <StackPanel Width="320" VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Header -->
            <Label Content="Create Account" FontSize="32" FontFamily="Arial" FontWeight="Bold" 
                   FontStyle="Italic" Background="#FFC242F3" Foreground="White" 
                   HorizontalAlignment="Center" Margin="0,0,0,15">
                <Label.Effect>
                    <DropShadowEffect/>
                </Label.Effect>
            </Label>

            <!-- First Name -->
            <Label Content="First Name" FontSize="14" FontWeight="Bold" Foreground="#FFC242F3" Padding="0,2,0,2"/>
            <TextBox x:Name="FirstNameTextBox" Height="28" BorderBrush="#FFC242F3" Margin="0,0,0,10" FontFamily="Arial" FontSize="18"/>

            <!-- Last Name -->
            <Label Content="Last Name" FontSize="14" FontWeight="Bold" Foreground="#FFC242F3" Padding="0,2,0,2"/>
            <TextBox x:Name="LastNameTextBox" Height="28" BorderBrush="#FFC242F3" Margin="0,0,0,10" FontFamily="Arial" FontSize="18"/>

            <!-- Email -->
            <Label Content="Email" FontSize="14" FontWeight="Bold" Foreground="#FFC242F3" Padding="0,2,0,2"/>
            <TextBox x:Name="EmailTextBox" Height="28" BorderBrush="#FFC242F3" Margin="0,0,0,10" FontFamily="Arial" FontSize="18"/>

            <!-- Create Password -->
            <Label Content="Create Password" FontSize="14" FontWeight="Bold" Foreground="#FFC242F3" Padding="0,2,0,2"/>
            <PasswordBox x:Name="CreatePasswordBox" Height="28" BorderBrush="#FFC242F3" Margin="0,0,0,10" FontSize="18"/>

            <!-- Confirm Password -->
            <Label Content="Confirm Password" FontSize="14" FontWeight="Bold" Foreground="#FFC242F3" Padding="0,2,0,2"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="28" BorderBrush="#FFC242F3" Margin="0,0,0,12" FontSize="18"/>

            <!-- Clickable Purple Text -->
            <TextBlock Text="Already have an account?" 
                       Foreground="#FFC242F3" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       TextDecorations="Underline"
                       HorizontalAlignment="Center" 
                       Cursor="Hand" 
                       Margin="0,0,0,15"
                       MouseDown="AlreadyHaveAccount_MouseDown"/>

            <!-- Sign Up Button at Bottom -->
            <Button x:Name="SignUpButton" Content="Sign Up" Height="45" 
                    BorderBrush="#FFC242F3" Foreground="#FFC242F3" BorderThickness="3" 
                    Background="White" FontSize="22" FontFamily="Arial" FontStyle="Italic" 
                    FontWeight="Bold" Click="SignUpButton_Click"/>

        </StackPanel>
    </Grid>
</Page>