<UserControl x:Class="Revision_App.RevisionTopicsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F5FC"
             FontFamily="Arial">

    <UserControl.Resources>
        <Style x:Key="TopicCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E7E0EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinHeight" Value="165"/>
        </Style>

        <Style x:Key="StartButton" TargetType="Button">
            <Setter Property="Background" Value="#7044A3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,24,24,28">

            <TextBlock Text="Revision Topics"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#30263B"/>

            <TextBlock Text="Choose a Computer Science topic to revise."
                       FontSize="13"
                       Foreground="#796F86"
                       Margin="0,6,0,22"/>

            <!-- Search -->
            <Border Background="White"
                    CornerRadius="10"
                    BorderBrush="#E7E0EF"
                    BorderThickness="1"
                    Padding="13,10"
                    Margin="5,0,5,18">

                <DockPanel LastChildFill="True">
                    <Image DockPanel.Dock="Left"
                           Source="/Images/Search.png"
                           Width="20"
                           Height="20"
                           Stretch="Uniform"
                           Margin="0,0,12,0"/>

                    <TextBox x:Name="SearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Type a topic name to search"/>
                </DockPanel>
            </Border>

            <TextBlock Text="Available Topics"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#4E287C"
                       Margin="5,0,0,10"/>

            <!-- Topic Cards -->
            <UniformGrid x:Name="TopicGrid" Columns="2">

                <Border Tag="Computer Systems"
                        Style="{StaticResource TopicCard}">
                    <StackPanel>
                        <TextBlock Text="Computer Systems"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#4E287C"/>

                        <TextBlock Text="Components, processors and system architecture."
                                   FontSize="13"
                                   Foreground="#796F86"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,18"/>

                        <Button Content="Start Revising"
                                Tag="Computer Systems"
                                Style="{StaticResource StartButton}"
                                Click="StartRevision_Click"/>
                    </StackPanel>
                </Border>

                <Border Tag="Algorithms"
                        Style="{StaticResource TopicCard}">
                    <StackPanel>
                        <TextBlock Text="Algorithms"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#4E287C"/>

                        <TextBlock Text="Searching, sorting and algorithm efficiency."
                                   FontSize="13"
                                   Foreground="#796F86"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,18"/>

                        <Button Content="Start Revising"
                                Tag="Algorithms"
                                Style="{StaticResource StartButton}"
                                Click="StartRevision_Click"/>
                    </StackPanel>
                </Border>

                <Border Tag="Programming"
                        Style="{StaticResource TopicCard}">
                    <StackPanel>
                        <TextBlock Text="Programming"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#4E287C"/>

                        <TextBlock Text="Programming techniques and problem solving."
                                   FontSize="13"
                                   Foreground="#796F86"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,18"/>

                        <Button Content="Start Revising"
                                Tag="Programming"
                                Style="{StaticResource StartButton}"
                                Click="StartRevision_Click"/>
                    </StackPanel>
                </Border>

                <Border Tag="Data Structures"
                        Style="{StaticResource TopicCard}">
                    <StackPanel>
                        <TextBlock Text="Data Structures"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#4E287C"/>

                        <TextBlock Text="Arrays, lists, stacks, queues and trees."
                                   FontSize="13"
                                   Foreground="#796F86"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,18"/>

                        <Button Content="Start Revising"
                                Tag="Data Structures"
                                Style="{StaticResource StartButton}"
                                Click="StartRevision_Click"/>
                    </StackPanel>
                </Border>

                <Border Tag="Databases"
                        Style="{StaticResource TopicCard}">
                    <StackPanel>
                        <TextBlock Text="Databases"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#4E287C"/>

                        <TextBlock Text="Relational databases, keys and SQL."
                                   FontSize="13"
                                   Foreground="#796F86"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,18"/>

                        <Button Content="Start Revising"
                                Tag="Databases"
                                Style="{StaticResource StartButton}"
                                Click="StartRevision_Click"/>
                    </StackPanel>
                </Border>

                <Border Tag="Legal, Moral and Ethical Issues"
                        Style="{StaticResource TopicCard}">
                    <StackPanel>
                        <TextBlock Text="Legal, Moral and Ethical Issues"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#4E287C"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="The impact of computing on individuals and society."
                                   FontSize="13"
                                   Foreground="#796F86"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,18"/>

                        <Button Content="Start Revising"
                                Tag="Legal, Moral and Ethical Issues"
                                Style="{StaticResource StartButton}"
                                Click="StartRevision_Click"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <TextBlock x:Name="NoResultsText"
                       Text="No topics found."
                       Visibility="Collapsed"
                       FontSize="14"
                       Foreground="#796F86"
                       Margin="8,15,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
