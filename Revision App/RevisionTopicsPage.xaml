<Page x:Class="Revision_App.RevisionTopicsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Revision Topics"
      Background="#F7F5FC"
      FontFamily="Arial">

    <!-- The dashboard already provides the header and sidebar. -->
    <ScrollViewer
                      VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30,24,30,24">

            <TextBlock Text="Revision Topics"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#333333"/>

            <TextBlock Text="Choose a topic you want to revise."
                           FontSize="15"
                           Foreground="#777777"
                           Margin="0,8,0,25"/>

            <!-- Search -->
            <TextBox x:Name="SearchBox"
                         Height="40"
                         FontSize="15"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="Search for a topic"/>

            <TextBlock Text="Available Topics"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,30,0,15"/>

            <!-- Topic cards -->
            <UniformGrid Columns="2" x:Name="TopicGrid">

                <Border Tag="Computer Systems"
                            Background="White"
                            CornerRadius="10"
                            Padding="20"
                            Margin="7">
                    <StackPanel>
                        <TextBlock Text="Computer Systems"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        <TextBlock Text="Explore the components and structure of computer systems."
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,15"
                                       Foreground="#666666"/>
                        <Button Content="Start Revising"
                                    Tag="Computer Systems"
                                    Click="StartRevision_Click"
                                    Background="#7044A3"
                                    Foreground="White"
                                    Padding="10"
                                    BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border Tag="Algorithms"
                            Background="White"
                            CornerRadius="10"
                            Padding="20"
                            Margin="7">
                    <StackPanel>
                        <TextBlock Text="Algorithms"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        <TextBlock Text="Learn about searching, sorting and algorithm efficiency."
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,15"
                                       Foreground="#666666"/>
                        <Button Content="Start Revising"
                                    Tag="Algorithms"
                                    Click="StartRevision_Click"
                                    Background="#7044A3"
                                    Foreground="White"
                                    Padding="10"
                                    BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border Tag="Programming"
                            Background="White"
                            CornerRadius="10"
                            Padding="20"
                            Margin="7">
                    <StackPanel>
                        <TextBlock Text="Programming"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        <TextBlock Text="Revise programming concepts and problem solving."
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,15"
                                       Foreground="#666666"/>
                        <Button Content="Start Revising"
                                    Tag="Programming"
                                    Click="StartRevision_Click"
                                    Background="#7044A3"
                                    Foreground="White"
                                    Padding="10"
                                    BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border Tag="Data Structures"
                            Background="White"
                            CornerRadius="10"
                            Padding="20"
                            Margin="7">
                    <StackPanel>
                        <TextBlock Text="Data Structures"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        <TextBlock Text="Understand arrays, stacks, queues and linked lists."
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,15"
                                       Foreground="#666666"/>
                        <Button Content="Start Revising"
                                    Tag="Data Structures"
                                    Click="StartRevision_Click"
                                    Background="#7044A3"
                                    Foreground="White"
                                    Padding="10"
                                    BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border Tag="Databases"
                            Background="White"
                            CornerRadius="10"
                            Padding="20"
                            Margin="7">
                    <StackPanel>
                        <TextBlock Text="Databases"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        <TextBlock Text="Revise database concepts, SQL and normalisation."
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,15"
                                       Foreground="#666666"/>
                        <Button Content="Start Revising"
                                    Tag="Databases"
                                    Click="StartRevision_Click"
                                    Background="#7044A3"
                                    Foreground="White"
                                    Padding="10"
                                    BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border Tag="Legal, Moral and Ethical Issues"
                            Background="White"
                            CornerRadius="10"
                            Padding="20"
                            Margin="7">
                    <StackPanel>
                        <TextBlock Text="Legal, Moral and Ethical Issues"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                        <TextBlock Text="Explore the effects of computing on society."
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,15"
                                       Foreground="#666666"/>
                        <Button Content="Start Revising"
                                    Tag="Legal, Moral and Ethical Issues"
                                    Click="StartRevision_Click"
                                    Background="#7044A3"
                                    Foreground="White"
                                    Padding="10"
                                    BorderThickness="0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <TextBlock x:Name="NoResultsText"
                           Text="No topics found."
                           FontSize="15"
                           Foreground="#777777"
                           Visibility="Collapsed"
                           Margin="10"/>

        </StackPanel>
    </ScrollViewer>
</Page>
